{
  "name": "ims",
  "scripts": {
    "dev": "docker-compose up -d && concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:seed": "npm run db:seed --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:studio": "npm run db:studio --prefix backend",
    "stop": "docker-compose down"
  },
  "dependencies": {
    "md-to-pdf": "^5.2.5",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
